[unit] #basic density, length and time units in CGS
rho0   = 1.67262e-24 #Default 1.67262e-24, 1 mp/cm^3
l0     = 3.0857e+18  #Default 3.0857e+18, 1 pc
t0     = 3.1536e13   #Default 3.1536e13, 1e6 yr

[cooling]
dirname          = ../../cloudyoutputs/production
fname            = cmz_1_14.5_22

#All ranges are in log10
met_interp_range = -1.5 1.5 4              # 
rho_interp_range = min+2   max-2    100    # min gives np.min, max gives np.max. 
eg_interp_range  = min+1.2 max-0.75 100    # 

#Reduce mu interpolation dimensionality - variation assumed along T only if true
reduce_mu_interp = True                    #
rho_rep          = 1.67e-24                # representative rho to choose
met_rep          = 1                       # representative met to choose

outname          = ../outputs/therm_tables/cooling_table.dat

[fdbk]
dirname          = ../../Starburst99/CGKZ3/Output
outname          = ../outputs/fdbk_tables/fdbk_table.dat

